# 麦当劳开放平台 MCP Token（https://open.mcd.cn/mcp → 控制台 → 激活 → 复制）
# 只在 --stdio 模式和 npm run probe 中生效；HTTP 模式每个请求自带 Token（x-mcd-token 请求头、?token= 或 Authorization: Bearer）
MCD_MCP_TOKEN=
# HTTP 模式监听端口（默认 3001）
PORT=3001
# 设为 1 时不访问官方接口，使用内置模拟数据（用于本地调试 UI）
MCD_MOCK=
# 官方 MCP 服务地址（可选，默认 https://mcp.mcd.cn）
MCD_MCP_URL=

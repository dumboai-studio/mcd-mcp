{
  "name": "@dumbo-ai/mcd-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "麦当劳点餐 MCP App：选门店 → 浏览菜单 → 购物车 → 结算 → 下单付款 → 订单状态",
  "bin": {
    "mcd-mcp": "dist/server/main.js"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').chmodSync('dist/server/main.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "concurrently --raw \"cross-env NODE_ENV=development vite build --watch\" \"tsx watch server/main.ts\"",
    "serve": "tsx server/main.ts",
    "serve:stdio": "tsx server/main.ts --stdio",
    "start": "node dist/server/main.js",
    "start:stdio": "node dist/server/main.js --stdio",
    "probe": "tsx scripts/probe.ts",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
